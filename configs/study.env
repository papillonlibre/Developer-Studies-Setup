# Names, ports and identities used on the VM. Sourced by scripts/lib/common.sh.
# Every value can be overridden from the environment.

# ── Local model ──
MODEL_ALIAS="${MODEL_ALIAS:-nemotron-bolt}"   # stable name served by llama.cpp
LLAMA_PORT="${LLAMA_PORT:-8000}"
LLAMA_CTX="${LLAMA_CTX:-262144}"              # 48GB+ recipe from the model card; total across slots
LLAMA_PARALLEL="${LLAMA_PARALLEL:-1}"         # TODO(pilot): Helix agents may need >1 (ctx is split per slot)

# ── Hermes provider name (Hermes' own config, not Helix's) ──
HERMES_PROVIDER="${HERMES_PROVIDER:-local-bolt}"

# ── Agent identity. THE agent under test, as Intake and Studio show it. ──
# Used by live Relay (ATIF agent_name/agent_version, OTLP service_name/service_version and the
# agent.name / agent.version resource attributes) AND written into the replayed traces,
# so there is exactly one agent with exactly one version.
HERMES_AGENT_NAME="${HERMES_AGENT_NAME:-hermes}"
HERMES_AGENT_VERSION="${HERMES_AGENT_VERSION:-1.0.0}"

# ── NeMo Relay -> Helix Intake ──
# Intake does not exist until participants start Helix; Relay just fails quietly until then.
INTAKE_WORKSPACE="${INTAKE_WORKSPACE:-default}"
INTAKE_OTLP_URL="${INTAKE_OTLP_URL:-http://127.0.0.1:8080/apis/intake/v2/workspaces/${INTAKE_WORKSPACE}/ingest/otlp/v1/traces}"
RELAY_OTLP_TYPE="${RELAY_OTLP_TYPE:-openinference}"   # validated with Relay 0.8.3 in NVIDIA's tutorial
RELAY_SCHEMA_VERSION="${RELAY_SCHEMA_VERSION:-3}"     # observability config version for Relay 0.8.x

# ── Setup bookkeeping ──
LAUNCH_LOG="${LAUNCH_LOG:-/tmp/spindrift-setup.log}"
SENTINEL="${SENTINEL:-/var/run/spindrift-ready}"
