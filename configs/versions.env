# Pinned versions. Change a pin only on purpose, and record why in the commit message.
# Sourced by scripts/lib/common.sh. Every value can be overridden from the environment.

# ── NeMo Helix (informational: participants install it, the VM only records the pin) ──
HELIX_VERSION_TAG="${HELIX_VERSION_TAG:-0.6.0}"
HELIX_DOCS_URL="https://docs.nvidia.com/nemo-helix/v0.6/documentation/home"
HELIX_CODE_URL="https://github.com/NVIDIA-NeMo/nemo-helix/tree/0.6.0"

# ── uv and Python ──
# uv version + installer checksum come from NVIDIA's hermes-relay-tracing tutorial pins.
# 0.12.9 is at or above Helix 0.6's minimum (0.9.14).
UV_VERSION="${UV_VERSION:-0.12.9}"
UV_INSTALLER_SHA256="${UV_INSTALLER_SHA256:-222e006c0fe4a0d793031833e469b21df72311f4e3526ffecca0e19e6dfabc32}"
HELIX_PYTHON="${HELIX_PYTHON:-3.12}"          # Helix 0.6 supports 3.12 / 3.13
HERMES_PYTHON="${HERMES_PYTHON:-3.11}"        # Hermes requires >=3.11,<3.14
HF_HUB_SPEC="${HF_HUB_SPEC:-==2.4.0}"         # huggingface_hub (provides `hf`)

# ── Hermes Agent (Nous Research), pinned by commit ──
# 0.21.3 is the version that generated the trace dataset. Its lockfile selects nemo-relay 0.8.3.
HERMES_REPO="${HERMES_REPO:-https://github.com/NousResearch/hermes-agent.git}"
HERMES_REF="${HERMES_REF:-v2026.9.14}"
HERMES_COMMIT="${HERMES_COMMIT:-345cd2b057a452236de401d3534b8502a7465e8d}"
HERMES_VERSION="${HERMES_VERSION:-0.21.3}"
NEMO_RELAY_VERSION="${NEMO_RELAY_VERSION:-0.8.3}"

# ── Model serving: llama.cpp (official CUDA server image) ──
# PINNED BY DIGEST (immutable). Resolved 2026-11-16 from tag server-cuda-b12429
# (llama.cpp build b12429, commit 9fba51d, multi-arch amd64+arm64, built for CUDA 12.8+).
# That commit has DFlash (`--spec-type draft-dflash`); older numbered tags (e.g. b9002) do not.
LLAMA_IMAGE="${LLAMA_IMAGE:-ghcr.io/ggml-org/llama.cpp@sha256:d68ec493c0ff9105ddfe2e909fff304117bc6e1fffbbd8d94182bd455983c264}"
LLAMA_IMAGE_TAG_FOR_HUMANS="server-cuda-b12429"

# ── Model files (Hugging Face, commits pinned 2026-11-16; both repos are ungated) ──
MODEL_REPO="${MODEL_REPO:-nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-GGUF}"
DRAFT_REPO="${DRAFT_REPO:-nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-LiLiCorr-GGUF}"
MODEL_REV="${MODEL_REV:-e0fecb69cb3e5e4c5e8a056fa2aec98c78e91246}"
DRAFT_REV="${DRAFT_REV:-182d2987939e12f458298b5d5f6ef98912f4ad6c}"
MODEL_FILE="NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB.gguf"
MMPROJ_FILE="mmproj-NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB.gguf"
DRAFT_FILE="NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-LiLiCorr.gguf"

# ── Example data: pinned commit of NVIDIA/nemoclaw-community (2026-11-04) ──
TRACES_REPO="${TRACES_REPO:-https://github.com/NVIDIA/nemoclaw-community.git}"
TRACES_SHA="${TRACES_SHA:-17a5af9b7eac0a33cb3a2b2f82bc83585cee8595}"
EXAMPLE_DIR="${EXAMPLE_DIR:-examples/tools/enterprise-assistant-harness-optimization}"
EXPECTED_TRACE_COUNT="${EXPECTED_TRACE_COUNT:-42}"
